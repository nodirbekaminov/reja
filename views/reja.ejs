<!DOCTYPE html>
<html lang="uz">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Reja va Maqsadlar</title>

  <link rel="stylesheet" href="/main.css" />
</head>

<body>

  <main class="page-container">

    <section class="todo-app">

      <!-- HERO -->
      <div class="hero">

        <div class="hero-badge">
          ✨ Bugungi maqsadlar
        </div>

        <h1>
          Rejalaringni yoz.<br />
          <span>Maqsadingga yet.</span>
        </h1>

        <p>
          Har bir katta natija kichik rejadan boshlanadi.
        </p>

      </div>


      <!-- MAIN CARD -->
      <div class="main-card">

        <!-- CREATE FORM -->
        <form id="create-form" class="create-form">

          <div class="input-wrapper">

            <span class="input-icon">✍️</span>

            <input id="create-field" name="reja" type="text" autocomplete="off" autofocus
              placeholder="Bugun nima qilmoqchisiz?" />

          </div>

          <button class="add-btn" type="submit">
            <span>+</span>
            Reja qo'shish
          </button>

        </form>


        <!-- LIST HEADER -->
        <div class="list-header">

          <div>
            <span class="small-title">REJALAR</span>

            <h2>Mening rejalarim</h2>
          </div>

          <div class="count-box">
            <strong id="plan-count">
              <%= items.length %>
            </strong>
            <span>ta reja</span>
          </div>

        </div>


        <!-- REJALAR -->
        <ul id="item-list">

          <% items.map(function(item, index) { %>

            <li class="plan-item">

              <div class="plan-content">

                <div class="plan-number">
                  <%= index + 1 %>
                </div>

                <div class="plan-info">

                  <span class="item-text">
                    <%= item.reja %>
                  </span>

                  <small>
                    Maqsadingiz sari yana bir qadam 🚀
                  </small>

                </div>

              </div>


              <div class="plan-actions">

                <button data-id="<%= item._id %>" class="edit-me" type="button">
                  ✏️
                  <span>O'zgartirish</span>
                </button>


                <button data-id="<%= item._id %>" class="delete-me" type="button">
                  🗑️
                  <span>O'chirish</span>
                </button>

              </div>

            </li>

            <% }) %>

        </ul>


        <!-- FOOTER -->
        <div class="card-footer">

          <p>
            💡 Kichik qadamlar katta natijalarga olib keladi.
          </p>

          <button id="clean-all" type="button">
            🗑 Hamma rejalarni tozalash
          </button>

        </div>

      </div>

    </section>

  </main>


  <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
  <script src="/browser.js"></script>

</body>

</html>
