<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>REJA</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body style="background-color: #b3b9c9">
  <div class="container" style="max-width: 700px">
    <h1 class="display-4 text-center py-4" style="color: #2c3e50">
      REJA VA MAQSADLAR
    </h1>

    <div class="jumbotron p-3 shadow-sm bg-white rounded-3 mb-4">
      <form id="create-form" action="/create-item" method="POST">
        <div class="d-flex align-items-center gap-2">
          <input id="create-field" name="reja" autofocus autocomplete="off" class="form-control" type="text"
            style="flex: 1" />
          <button class="btn btn-primary" style="border-radius: 20px; white-space: nowrap">
            Yangi Reja Qo'shish
          </button>
        </div>
      </form>
    </div>


    <ul id="item-list" class="list-group pb-3">
      <% items.map(function(item) { %>
        <li
          class="list-group-item list-group-item-info d-flex align-items-center justify-content-between mb-2 shadow-sm border-0 rounded">
          <span class="item-text">
            <%= item.reja %>
          </span>
          <div>
            <button data-id="<%= item. _id %>" class="edit-me btn btn-secondary btn-sm me-1">
              O'zgartirish
            </button>
            <button data-id="<%= item._id %>" class="delete-me btn btn-danger btn-sm">O'chirish</button>
          </div>
        </li>
        <% }) %>
    </ul>

    <button id="clean-all" class="btn btn-danger" style="border-radius: 20px; margin-top: 10px">
      Hamma Rejalarni O'chirish
    </button>
  </div>
  <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
  <script src="/browser.js"></script>
</body>

</html>